# Copy to .env and fill in. Never commit the real .env.

# --- Database (Supabase PostgreSQL) ----------------------------------------------------
# Use the transaction pooler (port 6543) with the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Supabase Storage (curriculum PDFs). Authentication no longer uses Supabase. -------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Create a PUBLIC bucket named "sarpebe-storage" in this project.

# --- Google Gemini ------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_GENERATION_MODEL=gemini-3.8-flash

# --- Redis (Celery broker/result backend, login rate limiting) ------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Authentication -----------------------------------------------------------------------
# REQUIRED. Signs access tokens; at least 32 characters. Changing it signs everyone out.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=
# Value of the `iss` claim; tokens with another issuer are rejected.
AUTH_JWT_ISSUER=sarpebe
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Seconds during which a just-rotated refresh token may be presented again (two tabs refreshing at once).
REFRESH_REUSE_GRACE_SECONDS=30
VERIFICATION_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_MINUTES=60
# true: users must open the emailed link before they can sign in.
REQUIRE_EMAIL_VERIFICATION=true
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Email ---------------------------------------------------------------------------------
# Base URL of the frontend, used in verification and password reset links.
FRONTEND_URL=http://localhost:3000
# "console" only logs emails (development). Use "smtp" in production, otherwise nobody can
# receive verification or reset links.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=SARPEBE <no-reply@your-domain.com>
SMTP_USE_STARTTLS=true

# --- HTTP / uploads --------------------------------------------------------------------------
# JSON list of browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:3000"]
MAX_UPLOAD_MB=20

# --- Seed users (optional; used by `python -m scripts.seed_users`) ------------------------------
# A password left empty is generated and printed once when the account is created.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=guru@example.com
SEED_USER_PASSWORD=

# --- AI pipeline (defaults are fine; see docs/ai-pipeline.md before changing) --------------------------------
GEMINI_RERANK_MODEL=gemini-2.5-flash-lite
GEMINI_JUDGE_MODEL=gemini-3.8-flash
# Retrieval: candidates per search, passages given to the model, minimum cosine similarity.
RAG_CANDIDATE_K=20
RAG_RERANK_SHORTLIST=12
RAG_TOP_K=6
RAG_CONTEXT_MAX_CHARS=14000
RAG_MIN_SIMILARITY=0.45
RAG_USE_RERANK=true
# Needs pgvector 0.8 or newer; keeps filtered vector searches from returning too few rows.
RAG_HNSW_ITERATIVE_SCAN=true
# Measure with `python -m evals.run retrieval` before turning this on.
EMBEDDING_USE_TASK_TYPES=false
# OCR for scanned PDF pages (one vision call per page; OCR_MAX_PAGES bounds the cost per document).
OCR_ENABLED=true
GEMINI_OCR_MODEL=gemini-3.5-flash-lite
OCR_MAX_PAGES=60
OCR_RENDER_DPI=150
OCR_CONCURRENCY=4
# Generation
GENERATION_THINKING_LEVEL=MEDIUM
GENERATION_MAX_OUTPUT_TOKENS=16000
# Leave unset to use the model default.
# GENERATION_TEMPERATURE=
LLM_MAX_ATTEMPTS=3
# Modules a free-tier teacher may start per 24 hours (0 = no limit; admins are never limited).
GENERATION_DAILY_LIMIT_FREE=10
# Bump when a prompt or schema changes; it is stored on every plan.
PROMPT_VERSION=lesson_plan.v2

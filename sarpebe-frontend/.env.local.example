# Copy to .env.local and fill in (cp .env.local.example .env.local). Never commit the real file.

# Base URL of the SARPEBE backend API (used by the browser and by NextAuth on the server).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public URL of this frontend.
NEXTAUTH_URL=http://localhost:3000

# Public address used for the sitemap, canonical link and share image. Falls back to NEXTAUTH_URL,
# so set it only when the two differ. No trailing slash.
# NEXT_PUBLIC_SITE_URL=https://sarpebe.example.com

# REQUIRED. Signs the session cookie, which also carries the access and refresh tokens.
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
